# ============================================================
#  .env.example  --  Copy to .env and fill in your secrets
#  NEVER commit your real .env to version control!
# ============================================================

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Threads Access Token (Long-lived token from Meta Developer Portal)
THREADS_ACCESS_TOKEN=your_threads_long_lived_access_token_here

# Your Threads User ID (numeric ID, optional - fetched automatically if blank)
# Find it at: https://graph.threads.net/v1.0/me?fields=id&access_token=YOUR_TOKEN
THREADS_USER_ID=

# Path to the state/cache file (default: processed_ids.json in project root)
STATE_FILE=processed_ids.json
